generator client {
    provider = "prisma-client"
    output   = "../app/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

enum UserRole {
    CLIENT
    DOCTOR
}

model User {
    id           String   @id @default(cuid())
    firstName    String
    lastName     String
    email        String   @unique
    passwordHash String
    role         UserRole @default(CLIENT)
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt
}
